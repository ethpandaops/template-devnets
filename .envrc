# Activates .venv on cd (https://direnv.net). Never installs anything: ./setup.sh does.
export VIRTUAL_ENV="$PWD/.venv"
PATH_add "$VIRTUAL_ENV/bin"

# mitogen sets up at most MITOGEN_POOL_SIZE connections in parallel (default 32);
# match `forks` in ansible/ansible.cfg. ansible.cfg cannot set it (env-only).
export MITOGEN_POOL_SIZE=100

watch_file .python-version uv.lock ansible/requirements.yaml
cat .python-version uv.lock ansible/requirements.yaml | cmp -s - .venv/.setup-inputs ||
  log_error "dependencies changed since the last ./setup.sh: run it again"
